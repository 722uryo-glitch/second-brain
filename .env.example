OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# UnoRouter AI Router
UNOROUTER_ENABLED=true
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_API_KEY=
# false = personal chat/memories remain local unless you explicitly opt in.
UNOROUTER_PRIVATE_CHAT=false
UNOROUTER_TIMEOUT_SECONDS=120
UNOROUTER_CHAT_MODELS=glm-5.3-flash-thinking:free,qwen3.8-flash-next:free,ling-3.0-flash-fin:free
UNOROUTER_VERIFY_MODELS=glm-5.3-flash-think-search:free,glm-5.3-flash-thinking:free,qwen3.8-flash-next:free
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.7
LLM_MODEL_COOLDOWN_SECONDS=90

# Executive Second Brain: plan -> memory -> iterative research -> gap check -> draft -> audit -> revise
EXECUTIVE_ENABLED=true
EXECUTIVE_REVIEW_ENABLED=true
EXECUTIVE_MAX_RESEARCH_QUERIES=3
EXECUTIVE_MAX_RESEARCH_ROUNDS=2
EXECUTIVE_MAX_REVISIONS=2
EXECUTIVE_HISTORY_TURNS=10
EXECUTIVE_SIMPLE_MAX_TOKENS=650
EXECUTIVE_LONG_MAX_TOKENS=2600

# Local general-web metasearch. run.ps1 auto-starts docker-compose.searxng.yml when Docker is available.
SEARXNG_ENABLED=true
SEARXNG_AUTO_START=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=12
RESEARCH_WEB_LIMIT=12
RESEARCH_FETCH_TOP_K=5
RESEARCH_FETCH_TIMEOUT_SECONDS=12
RESEARCH_HTTP_RETRIES=2

SECOND_BRAIN_DB=second_brain.db
DMN_INTERVAL_MINUTES=30
DMN_ENABLED=true
WHISPER_MODEL=small

# Global intelligence
EXTERNAL_COLLECTION_ENABLED=true
EXTERNAL_COLLECTION_INTERVAL_MINUTES=15
EXTERNAL_ITEMS_PER_FEED=100
EXTERNAL_CONCURRENCY=16
DOCUMENT_FETCH_ENABLED=true
DOCUMENT_FETCH_BATCH_SIZE=120
DOCUMENT_FETCH_CONCURRENCY=12
DOCUMENT_FETCH_INTERVAL_SECONDS=10

# Adaptive fact checking
FACTCHECK_ENABLED=true
FACTCHECK_INTERVAL_SECONDS=5
FACTCHECK_BATCH_SIZE=30
FACTCHECK_MAX_BATCH_SIZE=80

# Collectors
GDELT_ENABLED=true
GITHUB_ENABLED=true
GITHUB_EVENT_PAGES=5
BLUESKY_ENABLED=true
REDDIT_ENABLED=true
MASTODON_ENABLED=true
X_ENABLED=true

# Optional credentials. GitHub works without a token at lower rate limits.
GITHUB_TOKEN=
# X recent search needs official API access. Empty = adapter stays installed but is skipped.
X_BEARER_TOKEN=

GITHUB_SEARCH_QUERIES=artificial intelligence,agent,llm,cybersecurity,open source,robotics,computer vision,developer tools
X_QUERIES=AI,technology,cybersecurity,markets,politics,science,breaking news,war,climate,startup,open source
SOCIAL_QUERIES=AI,technology,cybersecurity,science,markets,politics,war,climate,open source,startup
MASTODON_INSTANCES=https://mastodon.social,https://fosstodon.org,https://mstdn.social

# Extra RSS/Atom feeds, comma separated
SECOND_BRAIN_FEEDS=

# Human-readable Obsidian knowledge layer
OBSIDIAN_ENABLED=true
OBSIDIAN_VAULT_PATH=obsidian_vault
OBSIDIAN_EXPORT_INTERVAL_MINUTES=30
OBSIDIAN_MAX_CLAIMS=300
OBSIDIAN_MAX_EXTERNAL=500
OBSIDIAN_MAX_MEMORIES=200
