OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
SECOND_BRAIN_DB=second_brain.db
DMN_INTERVAL_MINUTES=30
DMN_ENABLED=true
WHISPER_MODEL=small

# V1 global intelligence
EXTERNAL_COLLECTION_ENABLED=true
EXTERNAL_COLLECTION_INTERVAL_MINUTES=15
EXTERNAL_ITEMS_PER_FEED=100
EXTERNAL_CONCURRENCY=12
FACTCHECK_ENABLED=true
FACTCHECK_INTERVAL_SECONDS=20
FACTCHECK_BATCH_SIZE=20
GDELT_ENABLED=true
GITHUB_ENABLED=true
GITHUB_EVENT_PAGES=5
X_ENABLED=true

# Optional but strongly recommended for scale.
GITHUB_TOKEN=
# X recent-search requires API access. Leave blank to skip X cleanly.
X_BEARER_TOKEN=
# Customize X topics. Comma separated.
X_QUERIES=AI,technology,cybersecurity,markets,politics,science,breaking news,war,climate,startup,open source

# Extra RSS/Atom feeds, comma separated
SECOND_BRAIN_FEEDS=
